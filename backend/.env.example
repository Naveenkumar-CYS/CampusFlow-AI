# Copy this file to .env and fill in real values. Never commit .env itself.

# Full SQLAlchemy connection string. If set, this takes priority over the
# individual POSTGRES_* variables below.
DATABASE_URL=postgresql+psycopg2://postgres:devpassword@localhost:5432/campusflow

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=campusflow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=devpassword

# App
APP_ENV=development

# CORS -- comma-separated list of allowed browser origins. Default
# targets the local Next.js dev server. Set to the deployed frontend's
# real origin(s) in staging/prod.
CORS_ORIGINS=http://localhost:3000

# Redis Streams event bus (Stage 1). Defaults are fine for local dev with
# `docker run -p 6379:6379 redis:7`. Not required to run the API or the
# existing manual/direct automation trigger endpoints -- only needed when
# actually running events through RedisStreamEventBus.
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_NAME=campusflow.events
REDIS_CONSUMER_GROUP=campusflow-automation
REDIS_CONSUMER_NAME=automation-worker-1

# Automation transport (Person E, Step 2) -- how a real domain event
# (fee.paid, attendance.marked, ...) reaches the automation chain
# (Rule Engine -> Workflow Engine -> Action Executor).
# "in_process" (default) -- runs automation synchronously in the same
# request/process. Zero moving parts; what every existing unit test
# exercises. No separate worker needed.
# "redis" -- publishes onto the Redis Stream (REDIS_* above) and returns
# immediately; a separate event-worker process actually consumes it:
#   python -m app.worker
# This is the integrated/demo mode -- docker-compose sets it to "redis"
# for both the `backend` and `worker` services so they stay in sync.
AUTOMATION_TRANSPORT=in_process

# Notification Service (Stage 4).
# "mock" (default) -- no credentials needed, nothing real is ever sent.
# The full automation chain (attendance/fee -> email/SMS) runs against
# MockEmailProvider/MockSMSProvider out of the box.
# "live" -- switches to real SMTP + SMS-webhook providers. Requires the
# SMTP_*/SMS_* variables below to be set, or the app will raise a clear
# config error rather than silently falling back.
NOTIFICATION_PROVIDER_MODE=mock

# SMTP (real email). Only used when NOTIFICATION_PROVIDER_MODE=live.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# SMS (real, generic HTTP webhook -- not tied to any specific vendor).
# Only used when NOTIFICATION_PROVIDER_MODE=live. Point this at whatever
# SMS gateway the deployment actually uses.
SMS_WEBHOOK_URL=
SMS_API_KEY=
SMS_FROM_NUMBER=

# JWT auth — generate a strong random secret per environment, never reuse
# the example value, and never commit the real .env file.
JWT_SECRET=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Payment provider webhook — shared secret used to verify the
# X-Webhook-Signature HMAC-SHA256 header on inbound POST /payments/webhook
# requests. Provider-neutral (works with any provider that does
# HMAC-over-raw-body signing, e.g. Razorpay/Stripe-style). Generate a
# strong random value per environment, never reuse the example value.
PAYMENT_WEBHOOK_SECRET=change-me-to-a-long-random-value

# Encryption at rest (Person E, Step 2) — Fernet key used to encrypt/
# decrypt sensitive stored fields (see app/core/encryption.py). Must be
# a valid Fernet key (32 url-safe base64-encoded bytes). Generate one
# with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# No safe default is provided on purpose — set a real value via .env in
# every environment where encrypted fields (e.g. Student.phone) are
# read or written; leaving this unset raises a clear error instead of
# silently storing plaintext.
ENCRYPTION_KEY=

# Rate limiting (Person E, Step 1) — see app/core/rate_limit.py.
# Backed by the same Redis instance as the event bus above; falls back
# to an in-memory per-process counter if Redis is unreachable.
RATE_LIMIT_ENABLED=true

# POST /auth/login. per-account (email) is the real brute-force
# defense; per-IP is a coarser ceiling on top.
RATE_LIMIT_LOGIN_PER_ACCOUNT_MAX=8
RATE_LIMIT_LOGIN_PER_IP_MAX=60
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60

# POST /payments/webhook. Per-IP only — the caller is a payment
# provider's servers, not an individual account.
RATE_LIMIT_WEBHOOK_PER_IP_MAX=120
RATE_LIMIT_WEBHOOK_WINDOW_SECONDS=60